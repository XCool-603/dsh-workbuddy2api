{
  "name": "workbuddy2api-gateway",
  "displayName": "WorkBuddy 2API 网关与多号池控制台",
  "description": "在 WorkBuddy / CodeBuddy / VS Code 内自动拉起或接管本地多协议网关 (:7863)，提供侧边栏账号池概览、白蓝全功能控制台、OAuth 授权与每日签到猫猫福利引擎",
  "version": "1.3.0",
  "publisher": "xcool-603",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "workbuddy",
    "codebuddy",
    "openai",
    "anthropic",
    "claude-code",
    "gateway",
    "workbuddy2api"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workbuddy2api",
          "title": "WorkBuddy 2API",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "workbuddy2api": [
        {
          "type": "webview",
          "id": "workbuddy2api.sidebarView",
          "name": "账号池与网关控制台"
        }
      ]
    },
    "commands": [
      {
        "command": "workbuddy2api.openConsole",
        "title": "打开全功能控制台面板",
        "category": "WorkBuddy 2API",
        "icon": "$(layout)"
      },
      {
        "command": "workbuddy2api.openBrowser",
        "title": "在系统浏览器打开控制台",
        "category": "WorkBuddy 2API",
        "icon": "$(link-external)"
      },
      {
        "command": "workbuddy2api.refreshPool",
        "title": "刷新余额与账号池状态",
        "category": "WorkBuddy 2API",
        "icon": "$(refresh)"
      },
      {
        "command": "workbuddy2api.checkinAll",
        "title": "全池账号每日签到",
        "category": "WorkBuddy 2API",
        "icon": "$(calendar)"
      },
      {
        "command": "workbuddy2api.copyEndpoints",
        "title": "复制 API 接口接入地址",
        "category": "WorkBuddy 2API",
        "icon": "$(copy)"
      },
      {
        "command": "workbuddy2api.restartGateway",
        "title": "重启 / 重新探测本地网关",
        "category": "WorkBuddy 2API",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workbuddy2api.openConsole",
          "when": "view == workbuddy2api.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "workbuddy2api.refreshPool",
          "when": "view == workbuddy2api.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "workbuddy2api.openBrowser",
          "when": "view == workbuddy2api.sidebarView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "WorkBuddy 2API 网关与多号池",
      "properties": {
        "workbuddy2api.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "IDE 启动后自动启动内置多协议网关（若目标端口已有运行中的服务则自动接管复用）"
        },
        "workbuddy2api.port": {
          "type": "number",
          "default": 7863,
          "description": "本地多协议网关监听端口（默认 7863）"
        },
        "workbuddy2api.dshHome": {
          "type": "string",
          "default": "",
          "description": "账号池与配置持久化目录（留空则默认复用 ~/.dsh，与 DSH 桌面端共享同一账号池）"
        },
        "workbuddy2api.proxy": {
          "type": "string",
          "default": "",
          "description": "可选上游访问 HTTP 代理地址（例如 http://127.0.0.1:7890）"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XCool-603/dsh-workbuddy2api.git"
  }
}
